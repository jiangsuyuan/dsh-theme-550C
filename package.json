{
  "name": "@jiangsuyuan/dsh-theme-550c",
  "version": "1.0.0",
  "description": "550C: Wandering Earth control-room palette and frames for the DSH Web UI.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jiangsuyuan/dsh-theme-550C.git"
  },
  "homepage": "https://github.com/jiangsuyuan/dsh-theme-550C",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "screenshots.json",
    "docs/preview.png"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
